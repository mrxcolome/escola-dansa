# Redireccions canòniques: tot cap a https://escoladansa.com (sense www)
RewriteEngine On

# 1) www -> sense www (ja en https o no, sempre acaba a https sense www)
RewriteCond %{HTTP_HOST} ^www\.escoladansa\.com$ [NC]
RewriteRule ^ https://escoladansa.com%{REQUEST_URI} [L,R=301]

# 2) http -> https (condicions dobles per evitar bucles darrere del proxy/caché de Webempresa)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://escoladansa.com%{REQUEST_URI} [L,R=301]

# ── Redireccions de la web antiga (WordPress) cap a l'estructura nova ──
# seccions principals
RewriteRule ^inici/?$ https://escoladansa.com/ [L,R=301]
RewriteRule ^escola/?$ https://escoladansa.com/#escola [L,R=301,NE]
RewriteRule ^(activitats|category/activitats)/?$ https://escoladansa.com/#activitats [L,R=301,NE]
RewriteRule ^contacte/?$ https://escoladansa.com/#contacte [L,R=301,NE]
# subpàgines antigues d'horaris (graelles de cursos passats) -> pàgina d'horaris nova
RewriteRule ^horaris/(?!index\.html$).+$ https://escoladansa.com/horaris/ [L,R=301]
# articles del blog amb destí millor que la home
RewriteRule ^blog/classes-de-dansa-per-als-mes-petits/?$ https://escoladansa.com/dansa-infantil/ [L,R=301]
RewriteRule ^blog/modalitats-de-dansa-a-lescola-de-dansa-cristina-colome/?$ https://escoladansa.com/#activitats [L,R=301,NE]
RewriteRule ^blog/guia-dels-millors-maillots-de-dansa-i-on-comprar-los/?$ https://escoladansa.com/ballet-classic/ [L,R=301]
RewriteRule ^blog/escola-de-dansa-cristina-colome/?$ https://escoladansa.com/#escola [L,R=301,NE]
RewriteRule ^blog/beneficis-de-la-dansa-per-a-la-salut-fisica-i-mental/?$ https://escoladansa.com/dansa-adults/ [L,R=301]
# (des del set 2026, /blog/ és el blog NOU de la web: la resta d'URLs velles del WP fan 404)
RewriteRule ^(tag|author|category)/.+$ https://escoladansa.com/ [L,R=301]
RewriteRule ^inici_xmas(/.*)?$ https://escoladansa.com/ [L,R=301]
# casal i stage -> dansa infantil / home
RewriteRule ^casal-infantil-diver-dansa(/.*)?$ https://escoladansa.com/dansa-infantil/ [L,R=301]
RewriteRule ^stage-juvenil-global-dance(/.*)?$ https://escoladansa.com/ [L,R=301]

# ── Pàgina 404 personalitzada ──
# document intern reanomenat (Tramoia -> Backstage)
RewriteRule ^tramoia(/.*)?$ https://escoladansa.com/backstage/ [L,R=301]

ErrorDocument 404 /404.html

# ── Capçaleres Link (RFC 8288): descobriment de recursos per a agents d'IA ──
<IfModule mod_headers.c>
Header always set Link "<https://escoladansa.com/llms.txt>; rel=\"describedby llms-txt\", <https://escoladansa.com/sitemap.xml>; rel=\"sitemap\", <https://escoladansa.com/llms.txt>; rel=\"service-doc\""
</IfModule>

# robots.txt i llms.txt han de ser frescos (el hosting els posava cache d'1 any)
<IfModule mod_headers.c>
<Files "robots.txt">
Header always set Cache-Control "max-age=3600"
Header always unset Expires
</Files>
<Files "llms.txt">
Header always set Cache-Control "max-age=3600"
Header always unset Expires
</Files>
</IfModule>
